# Copy to .env and fill in locally. Never commit .env.
# GitHub
GITHUB_TOKEN=
GITHUB_REPOS=tiangolo/fastapi,encode/starlette,pydantic/pydantic
# Optional safety limits for a deliberately partial ingestion run.
# TARGET_RECORDS_PER_REPO=
# MAX_ENTRIES_TO_SCAN_PER_REPO=

# OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_GENERATION_MODEL=gpt-4o-mini
RAG_RETRIEVAL_MODE=vector
RAG_HNSW_EF_SEARCH=100
RAG_CONFIDENCE_THRESHOLD=0.5370554072220923
# Cost estimates use defaults in api.py; verify current model pricing before relying on them.
OPENAI_EMBEDDING_COST_PER_MILLION_TOKENS_USD=0.02
OPENAI_GENERATION_INPUT_COST_PER_MILLION_TOKENS_USD=0.15
OPENAI_GENERATION_OUTPUT_COST_PER_MILLION_TOKENS_USD=0.60
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
API_AUTH_TOKEN=
RAG_API_URL=https://w3qqwb25w0.execute-api.us-east-2.amazonaws.com

# AWS: access keys are optional when using an IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=
S3_BUCKET=

# RDS PostgreSQL
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require
